          "zarr-window",
          "blank-paper",
          "layout-frame-border",
          "native-coordinates",
          "layout-text-size",
          "label-guide",
          "project-crs",
          "dggs-system"
        ],
        "type": "string"
      },
      "maxItems": 256,
      "type": [
        "array",
        "null"
      ]
    },
    "shared": {
      "default": [],
