  "$id": "https://raw.githubusercontent.com/opengeos/RustGIS/main/schema/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A RustGIS project file, as RustGIS reads it. Generated from the Rust types by `cargo xtask schema`; don't edit it by hand. It writes format 2 and reads formats up to 2.",
  "properties": {
    "active_map": {
      "format": "uint",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "coordinate_system": {
      "anyOf": [
        {
          "$ref": "#/$defs/Crs"
        },
        {
          "type": "null"
        }
      ],
      "description": "The project's coordinate system (#2032 C3a): new maps are drawn in it, when a map can be,\nand new empty layers hold their coordinates in it. Maps and layers already in the project\nkeep theirs. `None`: new maps in Web Mercator and new layers in longitude/latitude, as\nbefore there was one. Saved with [`PROJECT_CRS`], which an older reader refuses rather\nthan saving the project again without it."
    },
    "crs_from_first_layer": {
      "description": "While the project has no coordinate system, the first layer added with one of its own\ngives it its system ([`Project::coordinate_system`]). Off by default.",
      "type": "boolean"
    },
    "data_stores": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Open"
      },
      "type": "array"
    },
    "dl_models": {
      "default": [],
      "description": "Trained deep learning models.",
      "items": {
        "$ref": "#/$defs/Open"
      },
      "type": "array"
    },
    "field_origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/FieldOrigin"
        },
        {
          "type": "null"
        }
      ],
      "description": "The home and area this field copy belongs to, retained through ordinary saves."
    },
    "folders": {
      "default": [],
      "description": "Folder connections shown in the Browser.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "format": {
      "default": 2,
      "description": "The format read from disk; serialization always declares the current writer's format.",
      "format": "uint32",
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "gp_env": {
      "$ref": "#/$defs/GpEnvironment",
      "default": {
        "cell_size": null,
        "extent": null
      },
      "description": "Geoprocessing environment settings."
    },
    "gp_history": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GpRecord"
      },
      "type": "array"
    },
    "jobs": {
      "default": [],
      "description": "Workflow Manager jobs.",
      "items": {
        "$ref": "#/$defs/Job"
      },
      "type": "array"
    },
    "layouts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Open"
      },
      "type": "array"
    },
    "link_views": {
      "default": false,
      "description": "Maps move together (View › Link Views).",
      "type": "boolean"
    },
    "maps": {
      "items": {
        "$ref": "#/$defs/Open"
      },
      "type": "array"
    },
    "models": {
      "default": [],
      "description": "Models: chains of tools, each step able to use an earlier step's output.",
      "items": {
        "$ref": "#/$defs/Model"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "next_table_id": {
      "default": 0,
      "description": "The id the next standalone table gets: removing a table, or undoing its addition, doesn't\nfree its id.",
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "notebooks": {
      "default": [],
      "description": "Notebooks of text and command cells.",
      "items": {
        "$ref": "#/$defs/Open"
      },
      "type": "array"
    },
    "offline_areas": {
      "default": [],
      "description": "Offline areas: snapshots of a map's data around an extent, synced back by feature id.",
      "items": {
        "$ref": "#/$defs/OfflineArea"
      },
      "type": "array"
    },
    "origin_id": {
      "description": "Persistent home-project identity for offline returns; legacy projects acquire it when packaged.",
      "type": "string"
    },
    "presentations": {
      "default": [],
      "description": "Presentations: pages of maps, text, images and videos.",
      "items": {
        "$ref": "#/$defs/Open"
      },
      "type": "array"
    },
    "ramps": {
