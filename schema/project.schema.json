{
  "$defs": {
    "AreaConflict": {
      "description": "A feature a sync or a Bring Back of an offline area changed in one place and found changed in\nthe other too, with the version that lost (#2468).",
      "properties": {
        "at": {
          "description": "When it was found, in seconds since 1970, as [`OfflineArea::synced`].",
          "format": "double",
          "type": "number"
        },
        "feature": {
          "description": "The feature, by its id in the map.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/ConflictKind"
        },
        "layer": {
          "description": "The layer, by id, in the area's map, and its name then.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "layer_name": {
          "type": "string"
        },
        "package": {
          "description": "The field package that brought it ([`FieldOrigin::package`]); empty for a sync, or for a\npackage made before packages had one.",
          "type": "string"
        },
        "shape": {
          "description": "Whether the shape lost too: then [`AreaConflict::geometry`] is the shape that lost, in\nlongitude/latitude (`None`: it had none).",
          "type": "boolean"
        },
        "values": {
          "description": "The values that lost, by field name.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Value"
              }
            ],
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "at",
        "layer",
        "layer_name",
        "feature",
        "kind"
      ],
      "type": "object"
    },
    "ConflictKind": {
      "description": "What happened to a feature changed in both places, and so which version an\n[`AreaConflict`] keeps.",
      "oneOf": [
        {
          "const": "replaced",
          "description": "Edited in both places: the field's version went in, and the values the map had lost.",
          "type": "string"
        },
        {
          "const": "deleted",
          "description": "Deleted in the field after a change in the map: deleted, and the map's feature lost.",
          "type": "string"
        },
        {
          "const": "kept",
          "description": "Deleted in the field after a change in the map: kept, and only the deletion lost.",
          "type": "string"
        },
        {
          "const": "dropped",
          "description": "Edited in the field but deleted in the map meanwhile: left deleted, and the field's edits\nlost.",
          "type": "string"
        }
      ]
    },
    "Coord": {
      "description": "A 2-D coordinate.",
      "properties": {
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Crs": {
      "description": "A raster's coordinate system. Saved as its EPSG code, or a custom one as its definition.",
      "oneOf": [
        {
          "enum": [
            "LonLat",
            "WebMercator"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Epsg": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "Epsg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Proj": {
              "properties": {
                "label": {
                  "type": "string"
                },
                "proj4": {
                  "type": "string"
                },
                "wkt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "proj4",
                "label"
              ],
              "type": "object"
            }
          },
          "required": [
            "Proj"
          ],
          "type": "object"
        }
      ]
    },
    "Date": {
      "description": "A calendar day as ISO 8601 text (YYYY-MM-DD), years 1 to 9999, maybe with spaces around it. The pattern can't tell a day that doesn't exist (2026-02-30); the reader refuses it.",
      "pattern": "^\\s*([1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[1-9])-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])\\s*$",
      "type": "string"
    },
    "DateTime": {
      "description": "A date and time as ISO 8601 text, years 1 to 9999, with its offset (Z, +02:00) when it has one, without one when it has none, maybe with spaces around it. The pattern can't tell a day that doesn't exist (2026-02-30) or an instant before year 1 or past year 9999 once its offset is applied (0001-01-01T00:00:00+01:00); the reader refuses them.",
      "pattern": "^\\s*([1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[1-9])-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])([Tt ]([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]{1,6}0*)?)?([Zz]|[+-]((0[0-9]|1[0-7])(:?[0-5][0-9])?|18(:?00)?))?)?\\s*$",
      "type": "string"
    },
    "Extent": {
      "description": "An axis-aligned rectangle. An \"empty\" extent has `min > max`.",
      "properties": {
        "max_x": {
          "format": "double",
          "type": "number"
        },
        "max_y": {
          "format": "double",
          "type": "number"
        },
        "min_x": {
          "format": "double",
          "type": "number"
        },
        "min_y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "min_x",
        "min_y",
        "max_x",
        "max_y"
      ],
      "type": "object"
    },
    "Feature": {
      "description": "One row: an optional geometry and one value per field.",
      "properties": {
        "attrs": {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "type": "array"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "attrs"
      ],
      "type": "object"
    },
    "Field": {
      "properties": {
        "alias": {
          "default": null,
          "description": "Display name (the field alias).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "ty": {
          "$ref": "#/$defs/FieldType"
        }
      },
      "required": [
        "name",
        "ty"
      ],
      "type": "object"
    },
    "FieldOrigin": {
      "description": "A field copy's exact home and offline-area identities (128 random bits each).",
      "properties": {
        "area": {
          "type": "string"
        },
        "generation": {
          "description": "The area's [`OfflineArea::generation`] when the package was made. Bring Back accepts a\npackage without a list of its changes only while the area still has it. Empty for a package\nmade before packages carried one.",
          "type": "string"
        },
        "ids": {
          "additionalProperties": false,
          "description": "The highest feature id each of the package's layers had when it was made, by layer id: a\nfeature added in the field is given an id above it, even after the features with the\nhighest ids are deleted, so it is never taken for one the package gave.",
          "patternProperties": {
            "^\\d+$": {
              "format": "uint64",
              "maximum": 9223372036854775806,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "package": {
          "description": "This package's own identity, new for each package made: Bring Back refuses a package whose\nidentity its area has brought back already ([`OfflineArea::returned`]), and the phone finds\nthe copy of the rows it was given by it. Empty for a package made before packages had one.",
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "area"
      ],
      "type": "object"
    },
    "FieldType": {
      "oneOf": [
        {
          "enum": [
            "Integer",
            "Double",
            "Text",
            "Boolean"
          ],
          "type": "string"
        },
        {
          "const": "Date",
          "description": "A calendar day.",
          "type": "string"
        },
        {
          "const": "DateTime",
          "description": "A moment: a date and time, with or without a zone.",
          "type": "string"
        }
      ]
    },
    "Geometry": {
      "description": "A geometry. Lines hold parts; polygons hold polygons of rings (first ring = exterior).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Point": {
              "$ref": "#/$defs/Coord"
            }
          },
          "required": [
            "Point"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "MultiPoint": {
              "items": {
                "$ref": "#/$defs/Coord"
              },
              "type": "array"
            }
          },
          "required": [
            "MultiPoint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Line": {
              "items": {
                "items": {
                  "$ref": "#/$defs/Coord"
                },
                "type": "array"
              },
              "type": "array"
            }
          },
          "required": [
            "Line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Polygon": {
              "items": {
                "items": {
                  "items": {
                    "$ref": "#/$defs/Coord"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            }
          },
          "required": [
            "Polygon"
          ],
          "type": "object"
        }
      ]
    },
    "GeometryType": {
      "oneOf": [
        {
          "enum": [
            "Point",
            "Polyline",
            "Polygon"
          ],
          "type": "string"
        },
        {
          "const": "None",
          "description": "A table with no geometry.",
          "type": "string"
        }
      ]
    },
    "GpEnvironment": {
      "description": "Settings every geoprocessing run honours.",
      "properties": {
        "cell_size": {
          "default": null,
          "description": "The cell size (degrees) of rasters tools create, when they don't say.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "extent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extent"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tools only process features meeting this longitude/latitude extent (when no features are\nselected)."
        },
        "projected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectedCells"
            },
            {
              "type": "null"
            }
          ],
          "description": "The projected coordinate system the Geostatistical Wizard makes its surface in, and the cell\nsize in its units, when the run doesn't say; `None`: the projected system the layer was read in,\nelse degrees with `cell_size`. Kept apart\nfrom `cell_size` so an older RustGIS, which reads only that, still makes it in degrees rather\nthan reading this system's units as degrees: losing it costs that version the setting, not\nthe raster."
        }
      },
      "type": "object"
    },
    "GpRecord": {
      "description": "One geoprocessing history row.",
      "properties": {
        "at": {
          "description": "When it ran, in seconds since 1970 (UTC); 0 in projects saved before it.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "command": {
          "description": "The command that ran the tool, when it wasn't `gp.run` with `params`: its id and its\nparameters, such as a point buffered where the map was clicked (`gp.bufferPoint`).",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            true
          ],
          "type": [
            "array",
            "null"
          ]
        },
        "id": {
          "description": "The tool's id (`buffer`), to run it again (#539); empty in projects saved before it,\nwhere the name finds a built-in tool.",
          "type": "string"
        },
        "messages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "millis": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "ok": {
          "type": "boolean"
        },
        "outputs": {
          "default": [],
          "description": "The layers the run added (by name at the time).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "params": true,
        "tool": {
          "description": "The tool's name, as shown.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "params",
        "ok",
        "messages",
        "millis"
      ],
      "type": "object"
    },
    "Job": {
      "description": "A unit of work tracked in the Workflow Manager.",
      "properties": {
        "assigned": {
          "default": "",
          "type": "string"
        },
        "created": {
          "description": "Seconds since 1970.",
          "format": "double",
          "type": "number"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "extent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extent"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The area the job covers (longitude/latitude), if any."
        },
        "id": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "description": "\"new\", \"in progress\", \"on hold\" or \"done\".",
          "type": "string"
        },
        "updated": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "created"
      ],
      "type": "object"
    },
    "Model": {
      "description": "A model: geoprocessing steps run in order. A parameter value `%n` stands for the output layer\nof step n (1-based). A model drawn in ModelBuilder keeps its `graph` too, which is what runs;\n`steps` then holds the same tools in run order, for older versions and web tools.",
      "properties": {
        "graph": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelGraph"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelStep"
          },
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ModelEdge": {
      "description": "An edge from node `from`'s output port to node `to`'s input port (a tool parameter's name).",
      "properties": {
        "from": {
          "type": "string"
        },
        "fromPort": {
          "default": "",
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "toPort": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "ModelGraph": {
      "description": "A model as ModelBuilder draws it: input, tool and output nodes joined by edges from an output\nport to an input port (see `crate::model`).",
      "properties": {
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelEdge"
          },
          "type": "array"
        },
        "nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelNode"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ModelNode": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ModelNodeKind"
        },
        "layer": {
          "description": "Input nodes: the layer (or standalone table) by name.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Output nodes: the name of the layer the result becomes.",
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "description": "Tool nodes: parameter values not supplied by an edge."
        },
        "tool": {
          "description": "Tool nodes: the tool id.",
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "default": 0.0,
          "description": "Where the node sits on the canvas (its top-left corner).",
          "format": "float",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "ModelNodeKind": {
      "oneOf": [
        {
          "const": "input",
          "description": "A layer of the map the model reads.",
          "type": "string"
        },
        {
          "const": "tool",
          "description": "A geoprocessing tool.",
          "type": "string"
        },
        {
          "const": "output",
          "description": "A result the model keeps, under a name.",
          "type": "string"
        }
      ]
    },
    "ModelStep": {
      "properties": {
        "params": true,
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "params"
      ],
      "type": "object"
    },
    "OfflineArea": {
      "description": "A map's data clipped to an extent, to take into the field.",
      "properties": {
        "conflicts": {
          "description": "The versions that lost when a sync or a Bring Back of the area found a feature changed both\nhere and in the field, oldest first: kept so they can be looked at again after the notice\nis gone (Data › Offline › Conflicts), until they are dismissed.",
          "items": {
            "$ref": "#/$defs/AreaConflict"
          },
          "type": "array"
        },
        "created": {
          "format": "double",
          "type": "number"
        },
        "data": {
          "$ref": "#/$defs/Open",
          "description": "The snapshot: the map's feature layers holding the features meeting the extent."
        },
        "extent": {
          "$ref": "#/$defs/Extent"
        },
        "generation": {
          "description": "Which state of the area its field packages were made from: given when a package is first\nmade of the area, and replaced at every sync or Bring Back. A package without a list of its\nchanges, compared with the area as last synced, comes back only while the area still has the\none it was made with, so it can't undo or repeat what came home since. Empty until a package\nis made.",
          "type": "string"
        },
        "id": {
          "description": "Persistent identity, independent of the editable display name.",
          "type": "string"
        },
        "ids": {
          "additionalProperties": false,
          "description": "The highest feature id each layer of its map had in any field package made of the area, by\nlayer id: a feature added to the map here is given an id above it, so a package still out\nnever takes one added since for a feature it was given.",
          "patternProperties": {
            "^\\d+$": {
              "format": "uint64",
              "maximum": 9223372036854775806,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "map": {
          "description": "The map it came from (by name).",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "returned": {
          "description": "The identities ([`FieldOrigin::package`]) of the field packages of this area already\nbrought back: each comes back once, so its changes can't be applied twice.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "synced": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "name",
        "map",
        "extent",
        "created",
        "data"
      ],
      "type": "object"
    },
    "Open": {
      "description": "Any object: this schema doesn't describe its fields.",
      "type": "object"
    },
    "ProjectedCells": {
      "description": "A projected coordinate system for the rasters the environment sets ([`GpEnvironment::projected`]).",
      "properties": {
        "cell_size": {
          "description": "The cell size in the system's units; `None`: the tool's own.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "crs": {
          "$ref": "#/$defs/Crs",
          "description": "The system, never one in degrees: `gp.env` refuses those, and opening a project leaves one\nout."
        }
      },
      "required": [
        "crs"
      ],
      "type": "object"
    },
    "StyleItem": {
      "description": "A saved style: a layer's symbology and labels.",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeometryType"
        },
        "labels": {
          "$ref": "#/$defs/Open"
        },
        "name": {
          "type": "string"
        },
        "renderer": {
          "$ref": "#/$defs/Open"
        },
        "transparency": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "name",
        "geometry",
        "renderer",
        "labels"
      ],
      "type": "object"
    },
    "Table": {
      "description": "A standalone table: a dataset without geometry, under an id unique among the project's tables (absent from files written before tables had ids).",
      "properties": {
        "crs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "crs_incomplete": {
          "default": false,
          "type": "boolean"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "type": "array"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "geometry_type": {
          "$ref": "#/$defs/GeometryType"
        },
        "held_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crs"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The system its features are in, when not longitude/latitude (`Dataset::held_in`)."
        },
        "id": {
          "default": 0,
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
